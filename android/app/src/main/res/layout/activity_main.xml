<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/base">

    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline" />
            </LinearLayout>
        </LinearLayout>

        <!-- online update (shown when a newer release exists) -->
        <LinearLayout
            android:id="@+id/updateCard"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_update"
            android:visibility="gone">
            <TextView
                android:id="@+id/updateTitle"
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_download"
                android:drawableTint="@color/beam" />
            <TextView
                android:id="@+id/updateDetail"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
            <ProgressBar
                android:id="@+id/updateProgress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="@color/beam"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/updateApply"
                    style="@style/Btn.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/upd_apply" />
                <Button
                    android:id="@+id/updateLater"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/upd_later" />
            </LinearLayout>
        </LinearLayout>

        <!-- Wi-Fi -->
        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_wifi"
                    android:drawableTint="@color/beam"
                    android:text="@string/wifi_title" />
<ImageButton
                    android:id="@+id/rescan"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="@string/search_again"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/text" />
            </LinearLayout>
            <TextView
                android:id="@+id/wifiStatus"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_searching" />
            <LinearLayout
                android:id="@+id/consoleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/ipInput"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:hint="@string/wifi_ip_hint"
                    android:inputType="text|textNoSuggestions" />
                <Button
                    android:id="@+id/ipConnect"
                    style="@style/Btn.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/connect" />
            </LinearLayout>
        </LinearLayout>

        <!-- USB -->
        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_usb"
                android:drawableTint="@color/beam"
                android:text="@string/usb_title" />
            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/usb_body" />
            <TextView
                android:id="@+id/usbStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:text="@string/usb_absent" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/usbConnect"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_usb"
                    android:drawableTint="@color/text"
                    android:text="@string/usb_connect" />
                <Button
                    android:id="@+id/usbCheck"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/usb_check" />
            </LinearLayout>
        </LinearLayout>

        <!-- PC hub -->
        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_pc"
                android:drawableTint="@color/beam"
                android:text="@string/hub_title" />
            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hub_body" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/hubInput"
                    style="@style/Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:hint="@string/hub_hint"
                    android:inputType="text|textNoSuggestions|textUri" />
                <Button
                    android:id="@+id/hubConnect"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/open" />
            </LinearLayout>
        </LinearLayout>

        <!-- Playback -->
        <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_stats"
                android:drawableTint="@color/beam"
                android:text="@string/settings_title" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mode_label"
                android:textColor="@color/text"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/modeLatency" style="@style/Btn" android:background="@drawable/bg_chip"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:paddingStart="6dp" android:paddingEnd="6dp" android:text="@string/mode_latency" />
                <Button android:id="@+id/modeBalanced" style="@style/Btn" android:background="@drawable/bg_chip"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="@string/mode_balanced" />
                <Button android:id="@+id/modeSmooth" style="@style/Btn" android:background="@drawable/bg_chip"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="@string/mode_smooth" />
            </LinearLayout>
            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:text="@string/mode_help" />
            <Switch
                android:id="@+id/audioSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/audio_label"
                android:textColor="@color/text"
                android:textSize="15sp" />
            <Switch
                android:id="@+id/padSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/pad_label"
                android:textColor="@color/text"
                android:textSize="15sp" />
            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:text="@string/pad_help" />
        </LinearLayout>

        <TextView
            android:id="@+id/footer"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
