<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="#2D3948"/><corners android:radius="26dp"/><stroke android:width="2dp" android:color="#F2B84B"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#CC1D2530"/><corners android:radius="26dp"/><stroke android:width="3dp" android:color="#F2B84B"/></shape></item>
